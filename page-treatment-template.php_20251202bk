function scg_txt_lite($v){
  $allowed = [
    'br'    => [],
    'small' => [],
    'b' => [], 'i' => [], 'strong' => [], 'em' => [],
    'sup' => [], 'sub' => [],
    'span' => ['class' => []],
    'a' => ['href' => [], 'target' => [], 'rel' => []],
  ];
  return wp_kses($v ?? '', $allowed);
}
function scg_txt($v){ return esc_html($v ?? ''); }
function scg_raw($v){ return $v ?? ''; }
function scg_img_url($id, $size='full'){ return $id ? wp_get_attachment_image_url($id, $size) : ''; }
function scg_has_text($v){ return strlen(trim(wp_strip_all_tags($v ?? ''))) > 0; }


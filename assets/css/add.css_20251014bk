.home-fv {
  overflow: hidden;
  padding: 120px 0 15px;
  background: linear-gradient(180deg, #fff 0%, #fbfbfb 70.19%, #f5f3f3 100%);
}
.home-fv .swiper {
  opacity: 0;
  transition: opacity 0.5s;
}
.home-fv .swiper.swiper-initialized {
  opacity: 1;
}

.home-fv-inner {
  margin: 0 auto;
  width: 90.233%;
}

.home-fv-slider {
  margin-bottom: 15px;
}

.home-fv-slider-item,
.home-fv-thumbnail-item-inner {
  overflow: hidden;
  width: 100%;
  height: auto;
  aspect-ratio: 1/1;
}
.home-fv-slider-item a,
.home-fv-thumbnail-item-inner a {
  display: block;
  width: 100%;
  height: 100%;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}
.home-fv-slider-item img,
.home-fv-thumbnail-item-inner img {
  width: 100%;
  height: 100%;
  -o-object-fit: cover;
     object-fit: cover;
  -o-object-position: center;
     object-position: center;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}

.home-fv-thumbnail-wrapper {
  position: relative;
}

.home-fv-thumbnail {
  margin: 0 auto;
  width: 75.2577%;
}
.home-fv-thumbnail.no-swiper {
  opacity: 1;
  transition-delay: 0.4s;
}
.home-fv-thumbnail.no-swiper .home-fv-thumbnail-list {
  display: flex;
  gap: 6.8494%;
  transform: none !important;
}
.home-fv-thumbnail.no-swiper .home-fv-thumbnail-item {
  width: 28.7671%;
}

.home-fv-thumbnail-item {
  box-sizing: border-box;
  outline: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.home-fv-thumbnail-item.is-active .home-fv-thumbnail-item-inner {
  opacity: 1;
  border-color: #dc5b8c;
}

.home-fv-thumbnail-item-inner {
  opacity: 0.6;
  box-sizing: border-box;
  border: 2px solid transparent;
  border-radius: 0.42em;
  transition: opacity 0.2s, border-color 0.2s;
}

.home-fv-thumbnail-button-wrapper {
  display: flex;
  opacity: 0;
  justify-content: space-between;
  align-items: center;
  position: relative;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96%;
  transition: opacity 0.5s;
}
.home-fv-thumbnail-button-wrapper.swiper-initialized {
  opacity: 1;
}
.home-fv-thumbnail-button-wrapper.is-disabled {
  display: none;
}
.home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-next,
.home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-prev {
  overflow: visible;
  position: relative;
  top: 0;
  right: 0;
  left: 0;
  margin-top: 0;
  width: 6%;
  height: auto;
  aspect-ratio: 1/1;
  -webkit-tap-highlight-color: transparent;
}
.home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-next img,
.home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-prev img {
  display: block;
  overflow: visible;
  width: 100%;
  height: 100%;
}
.home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-next::after,
.home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-prev::after {
  display: none;
}

@media (min-width: 769px) {
  .home-fv {
    padding: 130px 0 35px;
  }
  .home-fv-inner {
    max-width: 1620px;
  }
  .home-fv-slider {
    margin-bottom: 30px;
  }
  .home-fv-slider-item,
  .home-fv-thumbnail-item-inner {
    aspect-ratio: 134/55;
  }
  .home-fv-slider-item a,
  .home-fv-thumbnail-item-inner a {
    transition: opacity 0.5s;
  }
  .home-fv-slider-item a:hover,
  .home-fv-thumbnail-item-inner a:hover {
    opacity: 0.8;
  }
  .home-fv-thumbnail {
    width: 68.8645%;
  }
  .home-fv-thumbnail .swiper-slide {
    border-radius: 0.5em;
  }
  .home-fv-thumbnail.no-swiper .home-fv-thumbnail-list {
    gap: 2.66%;
  }
  .home-fv-thumbnail.no-swiper .home-fv-thumbnail-item {
    width: 23%;
  }
  .home-fv-thumbnail-item-inner {
    border-radius: 0.5em;
  }
  .home-fv-thumbnail-button-wrapper {
    width: 80%;
  }
  .home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-next,
  .home-fv-thumbnail-button-wrapper .home-fv-thumbnail-button-prev {
    width: 2.2883%;
  }
}
@media (width >= 1201px) {
  .home-fv {
    padding: 30px 0 35px;
  }
}